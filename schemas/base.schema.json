{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "base.schema.json",
  "title": "Metadata base",
  "description": "Metadata mínima común a toda entidad (§40). Los schemas de schemas/entities/ la extienden con allOf y cierran propiedades con unevaluatedProperties.",
  "type": "object",
  "required": [
    "id",
    "slug",
    "type",
    "title",
    "description",
    "created_at",
    "updated_at",
    "verification_status"
  ],
  "properties": {
    "id": {
      "description": "Identificador estable con forma <type>:<slug>. validate.py verifica la coherencia con type y slug.",
      "type": "string",
      "pattern": "^[a-z_]+:[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "slug": { "$ref": "enums.schema.json#/$defs/slug" },
    "type": { "$ref": "enums.schema.json#/$defs/entity_type" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "domain": { "$ref": "enums.schema.json#/$defs/slug" },
    "subdomain": { "$ref": "enums.schema.json#/$defs/slug" },
    "classification": { "$ref": "enums.schema.json#/$defs/classification" },
    "level": { "$ref": "enums.schema.json#/$defs/level" },
    "cloud": {
      "type": "array",
      "items": { "$ref": "enums.schema.json#/$defs/cloud" },
      "uniqueItems": true
    },
    "technologies": {
      "description": "Slugs de entidades technology o cloud_service asociadas. Deben existir.",
      "type": "array",
      "items": { "$ref": "enums.schema.json#/$defs/slug" },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "uniqueItems": true
    },
    "related_topics": {
      "description": "Slugs de entidades relacionadas para navegación. Deben existir.",
      "type": "array",
      "items": { "$ref": "enums.schema.json#/$defs/slug" },
      "uniqueItems": true
    },
    "sources": {
      "description": "Referencias a entidades source del Source Registry, con la página concreta consultada.",
      "type": "array",
      "items": { "$ref": "#/$defs/source_ref" }
    },
    "relations": {
      "description": "Aristas salientes del Knowledge Graph. Se guardan en una sola dirección; la inversa se deriva (ver relationships.schema.json).",
      "type": "array",
      "items": { "$ref": "relationships.schema.json" }
    },
    "created_at": { "$ref": "enums.schema.json#/$defs/date" },
    "updated_at": { "$ref": "enums.schema.json#/$defs/date" },
    "last_verified": { "$ref": "enums.schema.json#/$defs/date" },
    "verification_status": { "$ref": "enums.schema.json#/$defs/verification_status" },
    "jurisdiction": {
      "description": "Países (o EU) cuya ley origina el contenido (ADR-023). Solo en fichas del dominio privacy-engineering (ADR-023, enmiendas por ADR-027; EU y BR por la Enmienda 5) y en fuentes legislative.",
      "type": "array",
      "items": { "$ref": "enums.schema.json#/$defs/jurisdiction" },
      "minItems": 1,
      "uniqueItems": true
    },
    "legal_basis": {
      "description": "Artículos en que se apoya una ficha con jurisdiction (ADR-023); cada url es una cita legislative de sources.",
      "type": "array",
      "items": { "$ref": "#/$defs/legal_basis_ref" },
      "minItems": 1
    },
    "owner_approved_at": {
      "description": "Fecha de la aprobación explícita del dueño del proyecto; permitida en cualquier ficha y obligatoria para verified en fichas con jurisdiction (ADR-023, Enmienda 6).",
      "$ref": "enums.schema.json#/$defs/date"
    },
    "views": {
      "description": "Vistas estructuradas de la ficha (ADR-030). Cada clave mapea 1:1 con las props de su componente (en snake_case). central_idea, vigencia_timeline, practice_lanes y severity_cards se ubican con la marca «<!-- view: clave -->» en el cuerpo; approach va como desplegable propio tras el Resumen y sources_grouped reemplaza la lista de Fuentes.",
      "$ref": "#/$defs/views"
    },
    "stub": {
      "description": "true si la entidad es un marcador mínimo creado para sostener relaciones; su contenido está pendiente.",
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "description": "Una entidad verified (salvo las propias source) debe tener al menos una fuente y fecha de verificación.",
      "if": {
        "properties": {
          "verification_status": { "const": "verified" },
          "type": { "not": { "const": "source" } }
        },
        "required": ["verification_status", "type"]
      },
      "then": {
        "required": ["sources", "last_verified"],
        "properties": { "sources": { "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "views": {
      "type": "object",
      "required": [],
      "properties": {
        "central_idea": {
          "type": "object",
          "required": [
            "checks_title",
            "checks",
            "status",
            "risks_title",
            "risks",
            "closing"
          ],
          "properties": {
            "checks_title": {
              "type": "string",
              "minLength": 1
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "risks_title": {
              "type": "string",
              "minLength": 1
            },
            "risks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "text",
                  "tag"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tag": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            },
            "closing": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "vigencia_timeline": {
          "type": "object",
          "required": [
            "items",
            "as_of"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "date",
                  "title",
                  "detail",
                  "state"
                ],
                "properties": {
                  "date": {
                    "$ref": "enums.schema.json#/$defs/date"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "detail": {
                    "type": "string",
                    "minLength": 1
                  },
                  "links": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "label",
                        "href"
                      ],
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "href": {
                          "type": "string",
                          "format": "uri",
                          "pattern": "^https://"
                        }
                      },
                      "additionalProperties": false
                    },
                    "minItems": 1
                  },
                  "state": {
                    "enum": [
                      "past",
                      "current",
                      "proposed"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            },
            "as_of": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "approach": {
          "type": "object",
          "required": [
            "title",
            "intro",
            "steps"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "intro": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "description"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              "minItems": 2
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "title",
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "practice_lanes": {
          "type": "object",
          "required": [
            "lanes"
          ],
          "properties": {
            "start": {
              "type": "object",
              "required": [
                "title",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "lanes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "title",
                  "items"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "title",
                        "text"
                      ],
                      "properties": {
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1
                        },
                        "arq": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    },
                    "minItems": 1
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "severity_cards": {
          "type": "object",
          "required": [
            "levels"
          ],
          "properties": {
            "levels": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "level",
                  "amount",
                  "examples"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "level": {
                    "enum": [
                      1,
                      2,
                      3
                    ]
                  },
                  "amount": {
                    "type": "string",
                    "minLength": 1
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  },
                  "examples": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "sources_grouped": {
          "type": "object",
          "required": [
            "groups"
          ],
          "properties": {
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "title",
                  "sources"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "layout": {
                    "enum": [
                      "list",
                      "providers"
                    ]
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "title",
                        "urls",
                        "publisher"
                      ],
                      "properties": {
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "urls": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "format": "uri",
                            "pattern": "^https://"
                          },
                          "minItems": 1,
                          "description": "URLs de citas de sources; la API las resuelve en links con su label y nivel."
                        },
                        "publisher": {
                          "type": "string",
                          "minLength": 1
                        },
                        "why": {
                          "type": "string",
                          "minLength": 1
                        },
                        "provider": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    },
                    "minItems": 1
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "aliases": {
      "description": "Nombres anteriores o alternativos de la entidad, como los escribe su fuente (ADR-010). Un cambio de nombre se respalda con la página que lo dice en sources.",
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 100 },
      "uniqueItems": true
    },
    "legal_basis_ref": {
      "type": "object",
      "required": ["law", "article", "url", "implication"],
      "properties": {
        "law": { "$ref": "enums.schema.json#/$defs/law" },
        "article": {
          "description": "Artículo como lo numera el texto oficial, sin «art.» ni «°» (p. ej. 3, 14 quinquies, 16 quáter).",
          "type": "string",
          "pattern": "^[0-9]+( [a-záéíóú]+)?$"
        },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "note": { "type": "string" },
        "implication": {
          "description": "Implicancia técnica del artículo para la plataforma de datos (enmienda de ADR-023): qué se construye o se controla, sin repetir el texto legal.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "source_ref": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {
          "description": "Slug de una entidad de tipo source.",
          "$ref": "enums.schema.json#/$defs/slug"
        },
        "url": {
          "description": "Página concreta consultada dentro de la fuente.",
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "accessed": { "$ref": "enums.schema.json#/$defs/date" },
        "page_title": {
          "description": "Título de la página citada, tal como lo muestra la página (su encabezado principal). Distingue citas de una misma fuente (ADR-012).",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "label": {
          "description": "Rótulo corto que distingue dos citas con títulos de página casi iguales (ADR-029); la UI lo agrega al texto del enlace.",
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
