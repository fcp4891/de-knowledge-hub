# URL de PostgreSQL para el compilador y la API. docker-compose.yml expone el puerto 54329.
DATABASE_URL=postgresql+psycopg://dekh:dekh@localhost:54329/dekh

# Respaldos del estado personal (make backup-me / restore-me). Fuera del repo; por defecto ../dekh-backups.
# BACKUP_DIR=D:/Respaldos/dekh
# Cómo se ejecuta pg_dump/psql: compose (por defecto, dentro del contenedor db) | docker-host | local.
# BACKUP_RUNNER=compose
